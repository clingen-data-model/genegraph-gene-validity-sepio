** Full Corpus Validation

Run before any release candidate. This processes the complete event history.

#+begin_src clojure
(defn validate-full-corpus
  "Run all checks over the complete event store. Expects reset test-app state
  (version store cleared) before running to avoid version-state interference.
  Returns summary + first N failing IRIs per check."
  [source-file]
  (event-store/with-event-reader [r source-file]
    (->> (event-store/event-seq r)
         (map transform-curation)
         (run-and-summarize all-checks))))

;; Run -- takes several minutes
(comment
  (time (tap> (validate-full-corpus source-file))))

;; Website events over full corpus
(comment
  (time
   (tap>
    (event-store/with-event-reader [r source-file]
      (->> (event-store/event-seq r)
           (map transform-curation)
           run-website-event-checks)))))
#+end_src

** Corpus Selection Guide

To find events covering a specific dimension, use these patterns in the REPL
before adding a UUID to =sample-corpus=:

#+begin_src clojure
;; Find a curation using a specific SOP version
(def sop-query (rdf/create-query "select ?s where { ?a a :cg/Statement ; :cg/specifiedBy ?s }"))

(event-store/with-event-reader [r source-file]
  (->> (event-store/event-seq r)
       (take 500)
       (map transform-curation)
       (filter #(some-> % :gene-validity/model sop-query first str
                          (str/includes? "GeneValidityCriteria4")))
       (map #(-> % ::event/value (re-find #"[0-9a-f-]{36}")))
       first))

;; Find a curation with functional alteration evidence
(def fa-query
  (rdf/create-query
   "select ?el where { ?el a :cg/EvidenceLine ;
                       :cg/specifiedBy :cg/GeneValidityOverallFunctionalAlterationEvidenceCriteria }"))

(event-store/with-event-reader [r source-file]
  (->> (event-store/event-seq r)
       (take 500)
       (map transform-curation)
       (filter #(seq (fa-query (:gene-validity/model %))))
       (map #(-> % ::event/value (re-find #"[0-9a-f-]{36}")))
       first))

;; Find a curation with an unpublish event
(def unpub-query
  (rdf/create-query "select ?c where { ?c :cg/activityType :cg/Unpublished }"))

(event-store/with-event-reader [r source-file]
  (->> (event-store/event-seq r)
       (take 500)
       (map transform-curation)
       (filter #(seq (unpub-query (:gene-validity/model %))))
       (map #(-> % ::event/value (re-find #"[0-9a-f-]{36}")))
       first))
