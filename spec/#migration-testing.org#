(def statement-query
  (rdf/create-query "select ?x where { ?x a :cg/Statement }"))

(def has-statement
  "Every published model must contain exactly one cg:Statement."
  {:label :has-statement
   :check-fn #(= 1 (count (statement-query %)))})

(def has-kafka-iri
  "The Kafka key (::event/iri) must be non-empty.
  Fixes: add-iri-fn using old EvidenceStrengthAssertion class."
  {:label :has-kafka-iri
   :check-fn (fn [_model] true)                    ; checked at event level, not model
   :event-check-fn #(seq (::event/iri %))})

(def has-legacy-website-id
  "The model must contain a cg:websiteLegacyID triple.
  Fixes: add_legacy_website_id.sparql and legacy-website-id fn using old class/property names."
  {:label :has-legacy-website-id
   :check-fn (fn [m]
               (seq ((rdf/create-query
                      "select ?id where { ?a :cg/websiteLegacyID ?id }") m)))})

(def has-evaluated-contribution
  "Model must have a contribution with activityType cg:Evaluated.
  Validates: construct_statement.sparql and that approval-activity-query finds results."
  {:label :has-evaluated-contribution
   :check-fn (fn [m]
               (seq ((rdf/create-query
                      "select ?c where { ?c :cg/activityType :cg/Evaluated }") m)))})

(def has-submitted-contribution
  "Model must have a contribution with activityType cg:Submitted (publish action).
  Validates: new activity type terms in statement."
  {:label :has-submitted-contribution
   :check-fn (fn [m]
               (seq ((rdf/create-query
                      "select ?c where { ?c :cg/activityType :cg/Submitted }") m)))})

(def no-disconnected-evidence-lines
  "Every EvidenceLine must be reachable from the Statement.
  Fixes: validation.clj check updated to use cg:Statement."
  {:label :no-disconnected-evidence-lines
   :check-fn (fn [m]
               (let [q (rdf/create-query "
select ?el where {
  ?el a :cg/EvidenceLine .
  ?a a :cg/Statement .
  filter not exists { ?a :cg/hasEvidenceItems* | :cg/evidence* ?el . }
}")]
                 (empty? (q m))))})

(def has-evidence-lines
  "Statement must link to at least one EvidenceLine.
  Basic structural check for the evidence hierarchy."
  {:label :has-evidence-lines
   :check-fn (fn [m]
               (seq ((rdf/create-query
                      "select ?el where { ?a a :cg/Statement ; :cg/hasEvidenceLines ?el }") m)))})

(def has-classification
  "Statement must have a cg:classification."
  {:label :has-classification
   :check-fn (fn [m]
               (seq ((rdf/create-query
                      "select ?c where { ?a a :cg/Statement ; :cg/classification ?c }") m)))})

(def has-proposition
  "Model must contain a cg:GeneValidityProposition."
  {:label :has-proposition
   :check-fn (fn [m]
               (seq ((rdf/create-query
                      "select ?p where { ?p a :cg/GeneValidityProposition }") m)))})

(def unpublish-has-date
  "An unpublished model must have a contribution with activityType cg:Unpublished and a date.
  Fixes: website_events.clj using :cg/Unpublisher instead of :cg/Unpublished."
  {:label :unpublish-has-date
   :check-fn (fn [m]
               (let [unpub-q (rdf/create-query
                               "select ?d where { ?c :cg/activityType :cg/Unpublished ; :cg/date ?d }")]
                 ;; only applies to models that are unpublish events
                 (or (empty? ((rdf/create-query
                               "select ?c where { ?c :cg/activityType :cg/Unpublished }") m))
                     (seq (unpub-q m)))))})

;; Collect all publish-event checks
(def publish-checks
  [has-statement
   has-legacy-website-id
   has-evaluated-contribution
   has-submitted-contribution
   no-disconnected-evidence-lines
   has-evidence-lines
   has-classification
   has-proposition])

;; All checks including unpublish-specific
(def all-checks
  (conj publish-checks unpublish-has-date))
