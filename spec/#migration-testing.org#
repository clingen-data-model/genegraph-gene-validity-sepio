(defn load-corpus
  "Load and transform all events for UUIDs in sample-corpus.
  Returns a map of uuid -> seq of transformed events (all versions)."
  [source-file corpus]
  (let [uuids (set (map :uuid corpus))
        uuid-pattern (re-pattern (str/join "|" uuids))]
    (event-store/with-event-reader [r source-file]
      (->> (event-store/event-seq r)
           (filter #(re-find uuid-pattern (::event/value %)))
           (map transform-curation)
           (group-by #(-> % ::event/value
                          (as-> v (re-find uuid-pattern v))))
           (into {})))))
